# ==============================================================================
# K.O.S.H AI — Sovereign On-Premise Agentic AI Workbench
# Problem Statement: SIH26117 | Team ODIN
# ==============================================================================

# Core System Environment
APP_ENV=development
PORT=8000
HOST=0.0.0.0
MAX_UPLOAD_SIZE_MB=25
DATABASE_PATH=./kosh_ai.db
UPLOAD_DIR=../data/uploads
OUTPUT_DIR=../data/outputs
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model Configuration & Sovereignty
# Active Model Provider: 'gemini' (cloud fallback) or 'deterministic' (air-gap test)
# For air-gapped sovereign deployment: configure local LLM endpoint (Ollama / vLLM)
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional: Path to local Tesseract OCR binary (required only for scanned image PDFs)
TESSERACT_CMD=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
